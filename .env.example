# Trigger.dev local dev (loaded by `npm run dev:trigger`)
OPENROUTER_API_KEY=sk-or-v1-...

# Next.js server actions (.env.local, never .env). Get from Trigger.dev dashboard
# — use the *dev* secret key locally, *prod* key in Vercel.
TRIGGER_SECRET_KEY=tr_dev_...

# Supabase — same project URL goes in both .env and .env.local.
# Get values from Supabase Dashboard → Project Settings → API,
# or for the local CLI stack run `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (.env.local + Vercel) browser/server-action client
SUPABASE_SERVICE_ROLE_KEY=eyJ...                          # (.env + Trigger.dev project env) task write-back — never in the browser

# Only consumed by `npx supabase link` / `db push`. Not read by the app.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<db-password>

# Neon Postgres — same project across every surface. Copy both strings from the
# Neon Console → project → Connection Details. They differ only by the `-pooler` host suffix.
# DATABASE_URL = POOLED (`-pooler` host, PgBouncer txn mode). App runtime. Goes in .env, .env.local + Vercel.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED = DIRECT (no `-pooler`). drizzle-kit migrations only. Local (.env/.env.local); NOT in Vercel.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
# Auth.js (next-auth) session/JWT signing secret. Generate: `openssl rand -base64 32`.
# Use the SAME value locally and in Vercel. On Vercel the URL is auto-detected; if self-hosting,
# set AUTH_URL=https://your-domain (or pass trustHost: true in the auth config).
AUTH_SECRET=<openssl rand -base64 32>

# Stripe billing — sk_test_... locally, sk_live_... in Vercel prod.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints whsec_...
# Prod: Stripe Dashboard → Developers → Webhooks → endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# The $29/mo recurring price id created in Stripe Dashboard → Products
STRIPE_PRICE_ID=price_...
# Fallback origin for Stripe success_url / return_url when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=https://lead-qualifier.vercel.app
